# SPDX-License-Identifier: GPL-3.0-or-later
# AUR package for the app image a GitHub release publishes. See docs/releasing.md.

pkgname=hush-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='Minimal focus timer'
arch=('x86_64')
url='https://github.com/MoXcz/hush'
license=('GPL-3.0-or-later')
# The bundled Java runtime and Skiko link these system libraries.
depends=(
  'alsa-lib' 'fontconfig' 'freetype2' 'giflib' 'glibc' 'harfbuzz' 'lcms2' 'libgcc'
  'libglvnd' 'libjpeg-turbo' 'libpng' 'libstdc++' 'libx11' 'libxext' 'libxi'
  'libxrender' 'libxtst' 'zlib'
)
optdepends=(
  'libnotify: phase-end notifications'
  'avahi: pairing with the phone'
  'hyprland: apps during focus'
)
provides=('hush')
conflicts=('hush')
# Stripping would break the bundled Java runtime.
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/hush-$pkgver-linux-x86_64.tar.gz"
        'hush.desktop'
        'hush.sh')
sha256sums=('78aa92116828aca99afa0d497f2cc0d891a186664049c9ee6b964d7ee09d0171'
            '213405acd4a95db1125772bfebe694f97c4ae066a3e6249e14d93be5880375e4'
            '65f310829e362a8685c0905e2ead370c9323896e87043403814e79df76d556c9')

package() {
  install -d "$pkgdir/usr/lib/hush"
  cp -a "$srcdir/Hush/." "$pkgdir/usr/lib/hush/"
  rm "$pkgdir/usr/lib/hush/hush.svg" "$pkgdir/usr/lib/hush/hush.png"
  install -Dm755 "$srcdir/hush.sh" "$pkgdir/usr/bin/hush"
  install -Dm644 "$srcdir/hush.desktop" "$pkgdir/usr/share/applications/hush.desktop"
  install -Dm644 "$srcdir/Hush/hush.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hush.svg"
  install -Dm644 "$srcdir/Hush/hush.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/hush.png"
}
