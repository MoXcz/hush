root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,toml,yml,yaml,json}]
indent_size = 2

# Version catalog lookups (libs.versions.x.get().toInt()) read better on one line.
[*.kts]
ktlint_standard_chain-method-continuation = disabled
